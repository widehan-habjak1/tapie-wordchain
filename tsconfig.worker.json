{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "Bundler", "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "skipLibCheck": true, "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["worker", "shared"]
}
